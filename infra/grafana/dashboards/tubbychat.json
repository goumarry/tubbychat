     "expr": "histogram_quantile(0.99, sum by (le) (rate(ws_message_latency_seconds_bucket[1m])))",
     "legendFormat": "p99",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
