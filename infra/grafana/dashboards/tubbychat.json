     "legendFormat": "{{direction}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Latence de diffusion (instance d'origine → instance de destination)",
